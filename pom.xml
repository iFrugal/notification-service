<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.ifrugal</groupId>
        <artifactId>ifrugal-parent</artifactId>
        <version>1.0.16</version>
    </parent>

    <artifactId>notification-service</artifactId>
    <packaging>pom</packaging>
    <version>1.0.3-SNAPSHOT</version>

    <name>notification-service</name>
    <description>Multi-tenant notification service supporting email, SMS, WhatsApp, and push notifications</description>
    <url>https://github.com/iFrugal/notification-service</url>

    <scm>
        <connection>scm:git:https://x-access-token:${env.GITHUB_TOKEN}@github.com/iFrugal/notification-service.git</connection>
        <developerConnection>scm:git:https://x-access-token:${env.GITHUB_TOKEN}@github.com/iFrugal/notification-service.git</developerConnection>
        <url>https://github.com/iFrugal/notification-service</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>notification-api</module>
        <module>notification-core</module>
        <module>notification-channels</module>
        <module>notification-kafka</module>
        <module>notification-rest</module>
        <module>notification-redis</module>
        <module>notification-store-jdbc</module>
        <module>notification-spring-boot-starter</module>
        <module>notification-server</module>
    </modules>

    <properties>
        <!-- Java Version -->
        <java.version>25</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Spring Boot -->
        <spring-boot.version>4.1.1</spring-boot.version>

        <!-- all-about-persistence: shared version for persistence-api,
             persistence-utils, app-building-commons, and mongodb-persistence.
             Keep this as a single released version (not -SNAPSHOT) so the
             reactor resolves cleanly for every consumer, CI runner, and
             Central-Portal release job. -->
        <all-about-persistence.version>1.0.54</all-about-persistence.version>

        <!-- Jackson -->
        <!-- Imported as jackson-bom in dependencyManagement so every Jackson 2
             artifact resolves at this one version. The BOM import must stay
             above the Spring Boot BOM import so it wins. -->
        <jackson.version>2.22.2</jackson.version>

        <!-- Lombok -->
        <!-- 1.18.30 predates JDK 22 and fails on JDK 25 with:
             "com.sun.tools.javac.code.TypeTag :: UNKNOWN". 1.18.46 has
             native JDK 25 support. Bump when Lombok ships a newer release
             (Dependabot will open the PR). -->
        <lombok.version>1.18.46</lombok.version>

        <!-- Logging -->
        <slf4j.version>2.0.11</slf4j.version>

        <!-- Channel Provider Dependencies -->

        <aws-sdk.version>2.53.1</aws-sdk.version>
        <twilio.version>12.1.1</twilio.version>
        <jakarta-mail.version>2.0.2</jakarta-mail.version>

        <!-- Azure Communication Services Email (email-provider-acs).
             Pinned individually rather than through azure-sdk-bom: the
             latest BOM (1.3.8) still lists azure-communication-email 1.1.4
             and azure-core 1.58.1, older than what email 1.1.5 needs.
             azure-core is managed so every Azure artifact agrees on one
             version. azure-core-http-netty is excluded below because it
             pins Netty 4.1, which clashes with Spring Boot 4.1's Netty 4.2;
             the JDK HttpClient transport replaces it. -->
        <azure-communication-email.version>1.1.5</azure-communication-email.version>
        <azure-core.version>1.59.1</azure-core.version>
        <azure-core-http-jdk-httpclient.version>1.1.7</azure-core-http-jdk-httpclient.version>
        <azure-identity.version>1.18.6</azure-identity.version>


        <!-- Kafka -->
        <kafka.version>3.6.1</kafka.version>

        <!-- Bucket4j — token-bucket rate limiting (DD-12). 8.10.x is the
             current-stable line on Java 17+. A future Redis backend lives
             in a separate artifact (bucket4j-redis) that the distributed
             rate-limit DD will pull in alongside Redis-backed idempotency. -->
        <bucket4j.version>8.10.1</bucket4j.version>

        <!-- Springdoc OpenAPI — runtime schema generation + Swagger UI.
             The 3.x line targets Spring Boot 4 / Spring Framework 7 (the
             POM extends spring-boot-starter-parent:4.1.1 directly), so
             3.1.0 is the right pin for this codebase. -->
        <springdoc.version>3.1.0</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Jackson BOM: must stay above the Spring Boot BOM so it wins -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal Modules -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>notification-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>notification-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>notification-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>notification-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>notification-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Channel Modules -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>notification-channel-email</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>email-provider-smtp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>email-provider-ses</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>email-provider-acs</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>notification-channel-sms</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>sms-provider-twilio</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- all-about-persistence -->
            <dependency>
                <groupId>com.github.ifrugal</groupId>
                <artifactId>persistence-utils</artifactId>
                <version>${all-about-persistence.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.ifrugal</groupId>
                <artifactId>persistence-api</artifactId>
                <version>${all-about-persistence.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.ifrugal</groupId>
                <artifactId>app-building-commons</artifactId>
                <version>${all-about-persistence.version}</version>
            </dependency>

            <!-- Lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- AWS SDK -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Azure SDK (email-provider-acs) -->
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-core</artifactId>
                <version>${azure-core.version}</version>
            </dependency>
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-communication-email</artifactId>
                <version>${azure-communication-email.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>com.azure</groupId>
                        <artifactId>azure-core-http-netty</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-core-http-jdk-httpclient</artifactId>
                <version>${azure-core-http-jdk-httpclient.version}</version>
            </dependency>
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-identity</artifactId>
                <version>${azure-identity.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>com.azure</groupId>
                        <artifactId>azure-core-http-netty</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- Twilio -->
            <dependency>
                <groupId>com.twilio.sdk</groupId>
                <artifactId>twilio</artifactId>
                <version>${twilio.version}</version>
            </dependency>

            <!-- Jakarta Mail -->
            <dependency>
                <groupId>com.sun.mail</groupId>
                <artifactId>jakarta.mail</artifactId>
                <version>${jakarta-mail.version}</version>
            </dependency>

            <!-- Bucket4j (DD-12 rate limiting) -->
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j-core</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>

            <!-- Bucket4j Redis adapter — used by RedisRateLimiter
                 (DD-14). Brings Lettuce as a transitive dep. -->
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j-redis</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>

            <!-- Internal: notification-redis module -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>notification-redis</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Internal: notification-store-jdbc module -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>notification-store-jdbc</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Springdoc OpenAPI starter — exposes /v3/api-docs and
                 /swagger-ui out of the box on top of Spring MVC. Pulled
                 into notification-rest only; keeps the schema generator
                 inert in deployments that don't expose REST. -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Testing -->
        </dependencies>
    </dependencyManagement>

    <!-- Common dependencies for all modules -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Common test stack: JUnit 5 + AssertJ + Mockito (the briefing's
             standard, §5). Pulled in test scope so every module gets the
             same assertions and mocking primitives without each module
             having to declare them. Modules that need full Spring testing
             (MockMvc, @SpringBootTest, etc.) add spring-boot-starter-test
             themselves — this keeps the lightweight modules' test classpath
             from pulling all of Spring just for a unit test. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <!-- Lombok must stay first: processors run in this order,
                         and spring-boot-configuration-processor needs the
                         getters and setters Lombok generates to see the
                         @ConfigurationProperties members. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring-boot.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <failOnError>false</failOnError>
                            <additionalJOptions>
                                <additionalJOption>-Xdoclint:none</additionalJOption>
                            </additionalJOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                The parent waits for "published", which can exceed the plugin's 30-minute
                poll limit and fails the release after the upload already succeeded.
                "validated" fails fast on Central validation errors and lets publication
                finish asynchronously. publishingServerId is inherited from the parent.
            -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>${central-publishing-maven-plugin.version}</version>
                <configuration>
                    <autoPublish>true</autoPublish>
                    <waitUntil>validated</waitUntil>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
